# Copy this file to `.env` (dev), `.env.staging`, and `.env.production` and
# fill in real values. Only `.env.example` is committed — every other .env*
# file is gitignored (see android/app/build.gradle's envConfigFiles mapping,
# which picks the right one per build variant: debug -> .env,
# staging -> .env.staging, release -> .env.production).
#
# Nothing here is a secret by the time it ships — react-native-config bakes
# these into the compiled app (BuildConfig fields / Info.plist), so anything
# placed here is as public as the APK/IPA itself. The Razorpay key_secret,
# JWT secrets, DB credentials etc. stay server-side in cinema-hall-api's own
# .env and must never appear here.

# Base URL of cinema-hall-api. Dev host cheatsheet:
#   Android emulator  -> http://10.0.2.2:5000
#   Physical device   -> http://<your-LAN-IP>:5000  (or `adb reverse tcp:5000 tcp:5000`)
#   iOS simulator     -> http://localhost:5000
#   Production        -> https://api.yourdomain.com
API_BASE_URL=http://10.0.2.2:5000

# Google Sign-In OAuth client IDs — created separately from the web app's
# client ID in Google Cloud Console (Credentials -> OAuth client ID):
#   Android: type "Android", package com.myapp, keyed to your debug/release SHA-1
#   iOS:     type "iOS", bundle id matching Info.plist
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Allows http:// (cleartext) traffic on Android. Keep "true" for local dev
# against an http:// backend; set to "false" in .env.production so release
# builds refuse anything but HTTPS.
ENABLE_CLEARTEXT=true

# Toggles the in-memory mock services (src/services/*.mock.ts) instead of
# hitting the real API — useful for UI work with no backend running.
USE_MOCKS=false
